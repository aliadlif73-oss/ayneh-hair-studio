# Configure actual values only as runtime secrets, never here.
OWNER_EMAIL=
OWNER_ID=
# Password login for hosts without a platform identity gateway (Cloudflare, VPS).
OWNER_PASSWORD=
OWNER_PASSWORD_HASH=
SESSION_SECRET=
# Trust Sites/ChatGPT identity headers. Leave empty on Cloudflare.
TRUST_PLATFORM_IDENTITY=
KIE_API_KEY=
# Telegram bot (SETUP-TELEGRAM.md). Locally, TELEGRAM_BOT_TOKEN=dev-mock fakes Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
JOB_TOKEN=
# Melipayamak SMS (SETUP-SMS.md). MELIPAYAMAK_TOKEN is the random segment at the end of the console API
# address; it is a credential. Locally, MELIPAYAMAK_TOKEN=dev-mock fakes SMS (code is always 12345).
MELIPAYAMAK_TOKEN=
MELIPAYAMAK_BODY_ID=
APP_ORIGIN=
