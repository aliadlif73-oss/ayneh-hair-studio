# Configure actual values only as runtime secrets, never here.
OWNER_EMAIL=
OWNER_ID=
# Password login for hosts without a platform identity gateway (Cloudflare, VPS).
OWNER_PASSWORD=
OWNER_PASSWORD_HASH=
SESSION_SECRET=
# Trust Sites/ChatGPT identity headers. Leave empty on Cloudflare.
TRUST_PLATFORM_IDENTITY=
KIE_API_KEY=
# Telegram bot (SETUP-TELEGRAM.md). Locally, TELEGRAM_BOT_TOKEN=dev-mock fakes Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Melipayamak shared-line SMS (SETUP-SMS.md). Either the console token, or username + password/API key.
MELIPAYAMAK_TOKEN=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_OTP_BODY_ID=
MELIPAYAMAK_INVITE_BODY_ID=
JOB_TOKEN=
APP_ORIGIN=
